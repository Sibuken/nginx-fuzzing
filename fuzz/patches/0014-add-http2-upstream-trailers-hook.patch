--- a/src/http/modules/ngx_http_proxy_v2_module.c
+++ b/src/http/modules/ngx_http_proxy_v2_module.c
@@ -4256,4 +4256,277 @@ ngx_http_proxy_v2_finalize_request(ngx_http_request_t *r, ngx_int_t rc)
     ngx_log_debug0(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
                    "finalize proxy http2 request");
     return;
 }
+
+/* Fuzz-only adapter for the real HTTP/2 upstream trailer frame parser. */
+ngx_int_t
+ngx_http_proxy_v2_fuzz_trailers(u_char *data, size_t len,
+    ngx_uint_t *trailer_count)
+{
+    ngx_int_t                   rc;
+    size_t                      block_len, split, total, data_len, data_wire_len;
+    u_char                     *wire, *p;
+    ngx_log_t                   log;
+    ngx_pool_t                 *pool;
+    ngx_connection_t            connection;
+    ngx_http_request_t          r;
+    ngx_http_upstream_t         u;
+    ngx_http_proxy_v2_ctx_t     ctx;
+    ngx_http_proxy_v2_conn_t    h2c;
+    ngx_buf_t                   b;
+    ngx_list_part_t            *part;
+    ngx_uint_t                  mode;
+    ngx_uint_t                  padded, pad_len, invalid_padding, body_len, i;
+    ngx_uint_t                  second_data;
+    u_char                      body_byte;
+    u_char                      second_data_byte;
+    u_char                      data_bytes[2];
+    ngx_uint_t                  data_padded[2], data_pad_len[2];
+    size_t                      data_lens[2];
+
+    if (len == 0 || len > 16384) {
+        return NGX_DECLINED;
+    }
+
+    mode = data[0];
+    data++;
+    block_len = len - 1;
+    body_len = 0;
+    padded = 0;
+    pad_len = 0;
+    invalid_padding = 0;
+    second_data = 0;
+    data_wire_len = 0;
+
+    if (mode & 0x40) {
+        body_len = 2;
+        for (i = 0; i < 2; i++) {
+            if (block_len == 0) {
+                return NGX_DECLINED;
+            }
+            data_bytes[i] = *data++;
+            block_len--;
+            data_padded[i] = (mode & (i == 0 ? 0x10 : 0x20)) != 0;
+            data_pad_len[i] = 0;
+            if (data_padded[i]) {
+                if (block_len == 0) {
+                    return NGX_DECLINED;
+                }
+                data_pad_len[i] = *data++;
+                block_len--;
+            }
+            data_lens[i] = data_padded[i] ? 2 + data_pad_len[i] : 1;
+            data_wire_len += 9 + data_lens[i];
+        }
+
+    } else {
+        body_len = (mode & 0xb8) ? 1 : 0;
+        if (mode & 0x10) {
+        if (block_len < 2) {
+            return NGX_DECLINED;
+        }
+        body_byte = data[0];
+        pad_len = data[1];
+        data += 2;
+        block_len -= 2;
+        padded = 1;
+
+    } else if (mode & 0x20) {
+        if (block_len == 0) {
+            return NGX_DECLINED;
+        }
+        body_byte = *data++;
+        block_len--;
+        pad_len = 2;
+        padded = 1;
+        invalid_padding = 1;
+
+    } else if (mode & (8 | 0x80)) {
+        if (block_len == 0) {
+            return NGX_DECLINED;
+        }
+        body_byte = *data++;
+        block_len--;
+
+    } else {
+        body_byte = 0;
+    }
+
+    }
+
+    data_len = (body_len == 1)
+               ? (padded ? (invalid_padding ? 2 : 2 + pad_len) : 1)
+               : 0;
+    if (mode == (8 | 0x80) && body_len == 1 && block_len == 2
+        && data[0] == 0xff)
+    {
+        second_data = 1;
+        second_data_byte = data[1];
+        block_len = 0;
+    }
+    if (body_len == 1) {
+        data_wire_len = 9 + data_len;
+    }
+    split = block_len;
+
+    if (mode & 1) {
+        split = block_len / 2;
+    }
+
+    total = data_wire_len;
+    total += second_data ? 10 : 0;
+    total += 9 + block_len;
+    if (mode & 1) {
+        total += 9;
+    }
+
+    ngx_memzero(&log, sizeof(ngx_log_t));
+    ngx_memzero(&connection, sizeof(ngx_connection_t));
+    ngx_memzero(&r, sizeof(ngx_http_request_t));
+    ngx_memzero(&u, sizeof(ngx_http_upstream_t));
+    ngx_memzero(&ctx, sizeof(ngx_http_proxy_v2_ctx_t));
+    ngx_memzero(&h2c, sizeof(ngx_http_proxy_v2_conn_t));
+
+    log.log_level = NGX_LOG_EMERG;
+    connection.log = &log;
+
+    pool = ngx_create_pool(16384, &log);
+    if (pool == NULL) {
+        return NGX_ERROR;
+    }
+
+    r.connection = &connection;
+    r.pool = pool;
+    r.upstream = &u;
+    u.headers_in.status_n = NGX_HTTP_OK;
+    u.headers_in.content_length_n = -1;
+
+    if (ngx_list_init(&u.headers_in.trailers, pool, 4,
+                      sizeof(ngx_table_elt_t)) != NGX_OK)
+    {
+        ngx_destroy_pool(pool);
+        return NGX_ERROR;
+    }
+
+    h2c.recv_window = NGX_HTTP_V2_MAX_WINDOW;
+    ctx.id = 1;
+    ctx.state = ngx_http_proxy_v2_st_start;
+    ctx.connection = &h2c;
+    ctx.recv_window = NGX_HTTP_V2_MAX_WINDOW;
+    ctx.length = -1;
+
+    wire = ngx_palloc(pool, total);
+    if (wire == NULL) {
+        ngx_destroy_pool(pool);
+        return NGX_ERROR;
+    }
+
+    p = wire;
+    if (body_len == 2) {
+        for (i = 0; i < 2; i++) {
+            *p++ = (data_lens[i] >> 16) & 0xff;
+            *p++ = (data_lens[i] >> 8) & 0xff;
+            *p++ = data_lens[i] & 0xff;
+            *p++ = NGX_HTTP_V2_DATA_FRAME;
+            *p++ = data_padded[i] ? NGX_HTTP_V2_PADDED_FLAG : 0;
+            *p++ = 0;
+            *p++ = 0;
+            *p++ = 0;
+            *p++ = 1;
+            if (data_padded[i]) {
+                *p++ = data_pad_len[i];
+            }
+            *p++ = data_bytes[i];
+            while (data_pad_len[i]) {
+                *p++ = 0;
+                data_pad_len[i]--;
+            }
+        }
+
+    } else if (body_len == 1) {
+        *p++ = (data_len >> 16) & 0xff;
+        *p++ = (data_len >> 8) & 0xff;
+        *p++ = data_len & 0xff;
+        *p++ = NGX_HTTP_V2_DATA_FRAME;
+        *p++ = (padded ? NGX_HTTP_V2_PADDED_FLAG : 0)
+               | ((mode & 0x80) ? NGX_HTTP_V2_END_STREAM_FLAG : 0);
+        *p++ = 0;
+        *p++ = 0;
+        *p++ = 0;
+        *p++ = 1;
+        if (padded) {
+            *p++ = pad_len;
+        }
+        *p++ = body_byte;
+        while (!invalid_padding && pad_len) {
+            *p++ = 0;
+            pad_len--;
+        }
+    }
+
+    if (second_data) {
+        *p++ = 0;
+        *p++ = 0;
+        *p++ = 1;
+        *p++ = NGX_HTTP_V2_DATA_FRAME;
+        *p++ = 0;
+        *p++ = 0;
+        *p++ = 0;
+        *p++ = 0;
+        *p++ = 1;
+        *p++ = second_data_byte;
+    }
+
+    *p++ = (split >> 16) & 0xff;
+    *p++ = (split >> 8) & 0xff;
+    *p++ = split & 0xff;
+    *p++ = NGX_HTTP_V2_HEADERS_FRAME;
+    *p++ = (mode & 2) ? 0 : NGX_HTTP_V2_END_STREAM_FLAG;
+    *p++ = 0;
+    *p++ = 0;
+    *p++ = 0;
+    *p++ = 1;
+    if (split) {
+        p = ngx_cpymem(p, data, split);
+    }
+
+    if (mode & 1) {
+        size_t rest = block_len - split;
+        *p++ = (rest >> 16) & 0xff;
+        *p++ = (rest >> 8) & 0xff;
+        *p++ = rest & 0xff;
+        *p++ = NGX_HTTP_V2_CONTINUATION_FRAME;
+        *p++ = (mode & 4) ? 0 : NGX_HTTP_V2_END_HEADERS_FLAG;
+        *p++ = 0;
+        *p++ = 0;
+        *p++ = 0;
+        *p++ = 1;
+        if (rest) {
+            p = ngx_cpymem(p, data + split, rest);
+        }
+    } else {
+        wire[data_wire_len + 4] |=
+            (mode & 4) ? 0 : NGX_HTTP_V2_END_HEADERS_FLAG;
+    }
+
+    ngx_memzero(&b, sizeof(ngx_buf_t));
+    b.start = wire;
+    b.pos = wire;
+    b.last = p;
+    b.end = wire + total;
+
+    rc = ngx_http_proxy_v2_process_frames(&r, &ctx, &b);
+    for (i = 0; i < body_len && rc == NGX_OK; i++) {
+        /* Match the body-filter caller: consume DATA, then resume parsing. */
+        b.pos += ctx.rest - ctx.padding;
+        ctx.rest = ctx.padding;
+        rc = ngx_http_proxy_v2_process_frames(&r, &ctx, &b);
+    }
+    *trailer_count = 0;
+    for (part = &u.headers_in.trailers.part; part; part = part->next) {
+        *trailer_count += part->nelts;
+    }
+
+    ngx_destroy_pool(pool);
+    return rc;
+}
