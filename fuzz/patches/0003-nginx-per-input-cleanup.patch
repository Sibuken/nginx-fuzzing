--- a/src/fuzz/wrappers.c
+++ b/src/fuzz/wrappers.c
@@ -18,6 +18,32 @@
 #include <grp.h>
 #include <pwd.h>
 
+/* Track pool destruction without dereferencing stale nginx objects. */
+#define NGX_FUZZ_DESTROYED_POOL_CAPACITY 1024
+
+static void *ngx_fuzz_destroyed_pools[NGX_FUZZ_DESTROYED_POOL_CAPACITY];
+static size_t ngx_fuzz_destroyed_pool_count;
+
+void ngx_fuzz_reset_destroyed_pools(void) {
+  ngx_fuzz_destroyed_pool_count = 0;
+}
+
+int ngx_fuzz_pool_was_destroyed(void *pool) {
+  size_t i;
+  for (i = 0; i < ngx_fuzz_destroyed_pool_count; i++) {
+    if (ngx_fuzz_destroyed_pools[i] == pool) return 1;
+  }
+  return 0;
+}
+
+void __real_ngx_destroy_pool(void *pool);
+void __wrap_ngx_destroy_pool(void *pool) {
+  if (ngx_fuzz_destroyed_pool_count < NGX_FUZZ_DESTROYED_POOL_CAPACITY) {
+    ngx_fuzz_destroyed_pools[ngx_fuzz_destroyed_pool_count++] = pool;
+  }
+  __real_ngx_destroy_pool(pool);
+}
+
 int __wrap_connect(int sockfd, const struct sockaddr *addr, socklen_t addrlen) {
   return 0;
 }
