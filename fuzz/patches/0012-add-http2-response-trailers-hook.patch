+        ngx_destroy_pool(pool);
+        return NGX_ERROR;
+    }
+
+    if (flow_controlled == 5) {
+        if (ngx_http_v2_fuzz_output_calls != 0 || stream.queued == 0
+            || h2c.last_out == NULL || connection_write.ready
+            || remaining != NULL)
+        {
+            ngx_destroy_pool(pool);
+            return NGX_ERROR;
+        }
+
+        stream.blocked = 1;
+        connection_write.ready = 1;
+        retry_rc = ngx_http_v2_send_output_queue(&h2c);
+        stream.blocked = 0;
+
+        if (retry_rc != NGX_OK || ngx_http_v2_fuzz_output_calls != 1
+            || stream.queued != 0 || h2c.last_out != NULL
+            || !stream.out_closed)
+        {
+            ngx_destroy_pool(pool);
+            return NGX_ERROR;
+        }
+    }
+
+    if (flow_controlled == 7) {
+        if (ngx_http_v2_fuzz_output_calls != 1 || stream.queued != 0
+            || h2c.last_out != NULL || !stream.out_closed
+            || connection_write.ready || !connection_write.timer_set)
+        {
+            if (connection_write.timer_set) {
+                ngx_del_timer(&connection_write);
+            }
+            ngx_destroy_pool(pool);
+            return NGX_ERROR;
+        }
+
+        connection_write.ready = 1;
+        retry_rc = ngx_http_v2_send_output_queue(&h2c);
+
+        if (retry_rc != NGX_OK || ngx_http_v2_fuzz_output_calls != 2
+            || connection_write.timer_set)
+        {
+            if (connection_write.timer_set) {
+                ngx_del_timer(&connection_write);
+            }
+            ngx_destroy_pool(pool);
+            return NGX_ERROR;
+        }
+    }
+
+    ngx_destroy_pool(pool);
+    return NGX_OK;
+}
+
+static ngx_chain_t *
+ngx_http_v2_fuzz_output(ngx_connection_t *c, ngx_chain_t *in, off_t limit)
+{
+    ngx_chain_t  *cl;
+    ngx_buf_t    *b;
+    u_char        type;
+
+    ngx_http_v2_fuzz_output_calls++;
+
+    if (ngx_http_v2_fuzz_output_error) {
+        return NGX_CHAIN_ERROR;
+    }
+
+    for (cl = in; cl != NULL; cl = cl->next) {
+        b = cl->buf;
+
+        if (b->tag == (ngx_buf_tag_t) &ngx_http_v2_module
+            && ngx_buf_in_memory(b)
+            && (size_t) (b->last - b->pos) >= NGX_HTTP_V2_FRAME_HEADER_SIZE)
+        {
+            type = b->pos[3];
+            ngx_http_v2_fuzz_output_frames++;
+            if (type == NGX_HTTP_V2_DATA_FRAME) {
+                ngx_http_v2_fuzz_output_data++;
+            } else if (type == NGX_HTTP_V2_HEADERS_FRAME) {
+                ngx_http_v2_fuzz_output_headers++;
+            } else if (type == NGX_HTTP_V2_CONTINUATION_FRAME) {
+                ngx_http_v2_fuzz_output_continuations++;
+            }
+        }
+
+        if (ngx_buf_in_memory(b)) {
+            if (ngx_http_v2_fuzz_partial_output && b->pos < b->last) {
+                b->pos++;
+                ngx_http_v2_fuzz_partial_output = 0;
+            } else {
+                b->pos = b->last;
+            }
+        }
+
+        if (b->in_file) {
+            b->file_pos = b->file_last;
+        }
+    }
+
+    if (ngx_http_v2_fuzz_output_drop_ready) {
+        c->write->ready = 0;
+        ngx_http_v2_fuzz_output_drop_ready = 0;
+    }
+
+    (void) c;
+    (void) limit;
+    return NULL;
+}
